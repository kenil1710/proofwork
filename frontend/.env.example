# Copy to .env.local and fill in.

# Which GenLayer network to talk to: `studionet` or `bradbury`.
# Defaults to studionet when unset. Studionet is the public hosted Studio
# (https://studio.genlayer.com/api, chain 61999) — gasless, no faucet, and
# transactions settle in seconds rather than Bradbury's minutes.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Address of the deployed ProofWork Intelligent Contract.
# Network-specific: each network has its own deploy, so this must always be
# changed together with NEXT_PUBLIC_GENLAYER_NETWORK. A mismatch is silent —
# every read just returns null.
# Deploy with: node test/deploy.mjs --network=studionet --write-env
NEXT_PUBLIC_CONTRACT_ADDRESS=0x

# Reference only — lib/genlayer.ts uses genlayer-js's built-in chain
# definitions, which also carry the consensus contract addresses that the RPC
# URL alone does not provide.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999
